{
  "name": "uoft-agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && cd frontend && npm install",
  "postAttachCommand": {
    "api": "uvicorn api.main:app --reload --port 8001",
    "frontend": "cd frontend && npm run dev"
  },
  "portsAttributes": {
    "8001": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8001, 5173]
}
